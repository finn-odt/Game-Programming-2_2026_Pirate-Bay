:root {
    --main-color: rgb(184, 134, 11);
    --main-color-bright: rgb(251, 180, 3);
    --main-color-25a: rgba(184, 134, 11, 0.25);
    --main-color-15a: rgba(184, 134, 11, 0.15);
    --main-color-5a: rgba(184, 134, 11, 0.05);
    --main-color-darker: rgb(151 110 9);
    --main-color-dark: rgb(87 62 5);
    --icon-size: 13px;
    --icon-size-big: 20px;
}

.inventory-screen {
    width: 100%;
    height: 100%;

    display: flex;
    justify-content: flex-end;
    align-items: flex-end;

    background-color: rgba(0, 0, 0, 0);
}

.inventory-panel {
    /*position: absolute;
    /*top: 50%;
    left: 50%;*/
    /*transform: translate(-50%, -50%); /* set pivot to center */
    width: 80%;
    height: 78%;
    padding: 8px;
    margin: 2% 5%;
    background-color: rgba(18, 21, 24, 0.92);
    border-width: 2px;
    border-color: var(--main-color);
    border-radius: 6px;
}

.inventory-header {
    width: 65%;
    flex-direction: row;
    align-items: center;
    height: 10%;
    margin-bottom: 6px;
    flex-shrink: 0;
    margin-top: -5px;
}

.inventory-title {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 0;
    margin: 0;
}
.inventory-title-text {
    position: relative;
    flex-grow: 0;
    color: var(--main-color);
    font-size: 16px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}
.inventory-title-underline {
    position: absolute;
    left: 0;
    top: 18px;
    width: 37%;
    height: 2px;
    background-color: var(--main-color-darker);
    border-width: 0;
}

.inventory-status {
    color: rgb(177, 197, 190);
    font-size: 11px;
    margin-right: 6px;
    min-width: 44px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 0;
    margin: 0;
}

.close-button {
    position: absolute;
    top: 2px;
    right: 2px;
    background-color: rgba(0, 0, 0, 0);
    
    border-radius: 100%;
    border-width: 2px;
    border-color: var(--main-color);
    
    padding: 2px;
}
.close-button-icon {
    width: var(--icon-size);
    height: var(--icon-size);
    min-width: var(--icon-size);
    background-image: url("project://database/Assets/UI/Inventory/Textures/Close.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--main-color);
}

.drop-button {
    position: absolute;
    right: 1px;
    bottom: 3px;
    
    background-color: rgba(0, 0, 0, 0);

    border-radius: 5px;
    border-width: 2px;
    border-color: var(--main-color);

    padding: 2px;
}
.drop-button-icon {
    width: var(--icon-size-big);
    height: var(--icon-size-big);
    min-width: var(--icon-size-big);
    background-image: url("project://database/Assets/UI/Inventory/Textures/Drop.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--main-color);
}

.close-button:hover,
.drop-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--main-color-bright);
}

.empty-state {
    color: rgb(177, 197, 190);
    font-size: 13px;
    padding: 10px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}


.inventory-display {
    width: 100%;
    height: 90%;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: flex-start;
}

.inventory-list {
    flex-grow: 1;
    width: 65%;
    height: 100%;
}

.inventory-details {
    flex-grow: 1;
    width: 35%;
    height: 100%;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
    border-color: var(--main-color-darker);
    border-width: 1px;
    border-radius: 5px;
}

.inventory-details-name {
    font-size: 14px;
    color: var(--main-color);
}
.inventory-details-description {
    font-size: 9px;
    color: var(--main-color);
    white-space: normal;
    overflow: hidden;
}
.inventory-details-icon {
    height: 50%;
    -unity-background-scale-mode: scale-to-fit;
}
.inventory-details-quantity {
    position: absolute;
    top: 5px;
    left: 5px;
    color: white;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 0.5px;
}

.inventory-scroll {
    width: 100%;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 4px;
}

.inventory-slot {
    width: 36px;
    height: 36px;

    margin-right: 4px;
    margin-bottom: 4px;

    background-color: var(--main-color-5a);

    border-width: 1px;
    border-color: var(--main-color-darker);
    border-radius: 4px;
}
.inventory-slot.selected {
    background-color: var(--main-color-25a);
    border-color: var(--main-color-bright);
}

.inventory-slot-icon {
    position: absolute;
    top: -5%;
    left: -5%;
    
    width: 110%;
    height: 110%;
    -unity-background-scale-mode: scale-to-fit;
}

.inventory-slot-quantity {
    color: white;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 0.5px;
    font-size: 8px;
    -unity-font-style: bold;
    position: absolute;
    bottom: -5px;
    right: -3px;
}
.inventory-slot.selected .inventory-quantity {
    display: none;
}

.inventory-slot-drag-ghost {
    display: none;
    width: 36px;
    height: 36px;

    margin-right: 4px;
    margin-bottom: 4px;

    background-color: var(--main-color-25a);

    border-width: 1px;
    border-color: var(--main-color-bright);
    border-radius: 4px;
    position: absolute;
}

.inventory-slot-hidden-id {
    display: none;
}

.left-hand-equip-slot, .right-hand-equip-slot {
    width: 36px;
    height: 36px;

    margin-right: 4px;
    margin-bottom: 4px;

    color: var(--main-color);
    background-color: var(--main-color-5a);

    border-width: 1px;
    border-color: var(--main-color-darker);
    border-radius: 4px;
}
.left-hand-equip-slot.selected, .right-hand-equip-slot.selected {
    background-color: var(--main-color-25a);
    border-color: var(--main-color-bright);
}

.equip-slot-title {
    font-size: 5px;
    -unity-font-style: bold;
    position: absolute;
    top: 0;
    left: 0;
    background-color: var(--main-color-15a);
    padding: 0px;
    margin: 0px;
    width: 100%;
    -unity-text-align: middle-center;
    
}
