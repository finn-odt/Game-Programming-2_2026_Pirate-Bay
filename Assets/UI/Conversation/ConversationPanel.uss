:root {
    --main-color: rgb(184, 134, 11);
    --main-color-bright: rgb(251, 180, 3);
    --main-color-25a: rgba(184, 134, 11, 0.25);
    --main-color-5a: rgba(184, 134, 11, 0.05);
    --main-color-darker: rgb(151, 110, 9);
    --main-color-dark: rgb(87, 62, 5);
    --icon-size: 13px;
    --icon-size-big: 20px;
    --font-size: 10px;
    --font-size-small: 8px;
    
    --positive-color: rgb(11, 184, 46);
    --negative-color: rgb(184, 11, 11);
    --positive-color-back: rgba(11, 184, 46, 0.1);
    --negative-color-back: rgba(184, 11, 11, 0.1);
}

.conversation-screen {
    width: 100%;
    height: 100%;

    flex-direction: row;
    justify-content: center;
    align-items: flex-end;

    background-color: rgba(0, 0, 0, 0);
}

.conversation-box {
    width: 100%;
    height: 18%;
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    margin: 2%;
}

.conversation-panel {
    width: 70%;
    height: 100%;
    padding: 2px 6px;
    background-color: rgba(18, 21, 24, 0.92);
    border-width: 2px;
    border-color: var(--main-color);
    border-radius: 6px;
}

.spoken-words {
    font-size: var(--font-size);
    color: var(--main-color-bright);
    margin: 0;
    white-space: normal;
    overflow: hidden;
}

.button-indicators {
    width: 25%;
    height: 100%;
    
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: space-evenly;
    align-items: center;
    
    padding: 2px 6px;
    
    background-color: rgba(18, 21, 24, 0.8);
    border-width: 2px;
    border-color: var(--main-color-darker);
    border-radius: 6px;
}

.acceptance, .decline {
    width: 100%;
    height: 40%;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-start;
    align-items: center;
    border-radius: 2px;
}

.acceptance {
    background-color: var(--positive-color-back);
}
.decline {
    background-color: var(--negative-color-back);
}

.accept-buttons-label {
    color: var(--positive-color);
    font-size: var(--font-size-small);
    -unity-text-align: middle-left;
}
.decline-buttons-label {
    color: var(--negative-color);
    font-size: var(--font-size-small);
    -unity-text-align: middle-left;
}

.accept-button-icon, .decline-button-icon {
    height: 15px;
}
