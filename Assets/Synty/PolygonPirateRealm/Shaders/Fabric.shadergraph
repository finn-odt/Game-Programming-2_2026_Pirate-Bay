            "m_Id": "5e6fc3b6674b4da1a53b02712f96c0fb"
        },
        {
            "m_Id": "10daabb51d1c4917926b080d16d01681"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MainLight",
    "m_FunctionSource": "",
    "m_FunctionBody": "#ifdef SHADERGRAPH_PREVIEW\n    MainLightDirection = float3(0.5, 0.5, 0);\n    MainLightIntensity = 1.0f;\n#else\n    #if defined(UNIVERSAL_LIGHTING_INCLUDED)\n        // --- URP Pipeline ---\n        Light mainLight = GetMainLight();\n        MainLightDirection = mainLight.direction;\n        MainLightIntensity = length(mainLight.color);\n    #else\n        // --- Built-in Render Pipeline (BIRP) ---\n        // _WorldSpaceLightPos0.xyz holds the direction towards the main light\n        MainLightDirection = _WorldSpaceLightPos0.xyz;\n        \n        // _LightColor0 holds the color and intensity values\n        MainLightIntensity = length(_LightColor0.rgb);\n    #endif\n#endif"
}

